#include <metal_stdlib>
using namespace metal;

struct VertexIn {
    float2 position [[attribute(0)]];
    float2 uv [[attribute(1)]];
};

struct VertexOut {
    float4 position [[position]];
    float2 uv;
};

vertex VertexOut vertex_main(
    VertexIn in [[stage_in]],
    constant uint2& texture_size [[buffer(0)]]
) {
    float2 clip_position = (in.position / float2(texture_size)) * 2.0 - 1.0;
    clip_position.y = -clip_position.y;
    VertexOut out;
    out.position = float4(clip_position, 0.0, 1.0);
    out.uv = in.uv;
    return out;
}

fragment float4 fragment_main(
    VertexOut in [[stage_in]],
    texture2d<float> glyph_texture [[texture(0)]],
    sampler s [[sampler(0)]]
) {
    float alpha = glyph_texture.sample(s, in.uv).r;
    return float4(1.0, 1.0, 1.0, alpha);
}
